# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="UPI Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
# Installer sets both URLs to the public address, including a subdirectory prefix.
# Do not append /public. Leave ASSET_URL empty to use APP_URL unless using a separate asset origin.
ASSET_URL=
# Comma-separated IPs/CIDRs of proxies directly connecting to PHP. Never use *.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Public merchant self-registration is disabled. Set true only to open signups intentionally.
ALLOW_REGISTRATION=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'error' in production to avoid leaking debug info.
LOG_LEVEL=error

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upi_gateway
DB_USERNAME=root
DB_PASSWORD=
# By default, the browser installer strictly restricts the database host to local
# connections (127.0.0.1 or localhost) to prevent SSRF and database credential exfiltration.
# To connect to an external or managed MySQL service (e.g. AWS RDS, DigitalOcean Managed
# Database, or a private VPC host), set INSTALLER_ALLOW_REMOTE_DB=true in this file or your
# server environment before opening the installation wizard.
# INSTALLER_ALLOW_REMOTE_DB=false

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production — encrypts session data at rest.
SESSION_ENCRYPT=true
# HTTPS production deployments must send session cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Installer scopes this to / for domains or /your-prefix/ for subdirectory installations.
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
WEBHOOK_OUTBOX_BATCH_SIZE=100
BROADCAST_CONNECTION=log

# ─── Cache ────────────────────────────────────────────────────────────────────
# Use a shared database or Redis cache for limiter state across workers/nodes.
CACHE_STORE=database
CACHE_LIMITER=database

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Gateway ──────────────────────────────────────────────────────────────────
# Minutes a payment link stays valid.
GATEWAY_ORDER_EXPIRY_MINUTES=15
# Per-merchant API key order creation limit per minute (default 1000).
GATEWAY_ORDER_CREATE_API_KEY_RATE_LIMIT=1000
# Existing per-merchant limit for account listing and order status reads.
GATEWAY_API_KEY_RATE_LIMIT=120
# Per-IP API abuse limit remains active for all authenticated API endpoints.
GATEWAY_API_IP_RATE_LIMIT=600
# Recover provider-verified late payments for this many hours after expiry (0 disables).
GATEWAY_LATE_PAYMENT_GRACE_HOURS=24
# Minimum 120 seconds; applies even to forced checks of expired orders.
GATEWAY_LATE_PAYMENT_CHECK_INTERVAL_SECONDS=300
# Maximum due pending orders checked per scheduler cycle (1–1000).
GATEWAY_PENDING_VERIFICATION_BATCH_SIZE=100
# Maximum due expired orders checked per scheduler cycle (1–1000).
GATEWAY_LATE_PAYMENT_BATCH_SIZE=100
# Distributed lock lease seconds for the orders:check-pending scheduler command (60–3600).
GATEWAY_SCHEDULER_LOCK_SECONDS=300
# Provider verification ownership. Use a stable, unique node ID on every host/container.
GATEWAY_VERIFICATION_LEASE_SECONDS=120
GATEWAY_VERIFICATION_NODE_ID=change-me-unique-node-id
# Provider evidence binding and maximum evidence age in seconds (Priority 26).
GATEWAY_EVIDENCE_REQUIRE_TIMESTAMP=true
GATEWAY_EVIDENCE_MAX_AGE_SECONDS=86400
GATEWAY_EVIDENCE_CLOCK_SKEW_SECONDS=300
GATEWAY_PROVIDER_TIMEZONE=Asia/Kolkata

# Set to true ONLY for local dev to allow http:// webhook URLs.
GATEWAY_WEBHOOK_ALLOW_INSECURE=false

# Set to true ONLY for local dev to allow http:// redirect URLs.
GATEWAY_ALLOW_INSECURE_REDIRECTS=false

# Set to false to switch CSP to report-only mode (useful during deployment rollout).
GATEWAY_CSP_ENFORCE=true

# Paytm for Business status endpoint (unofficial).
# PAYTM_STATUS_URL=https://securegw.paytm.in/merchant-status/getTxnStatus

# Paytm Payment Gateway base URLs.
# PAYTM_PG_SANDBOX_URL=https://securestage.paytmpayments.com
# PAYTM_PG_PRODUCTION_URL=https://secure.paytmpayments.com

# ─── AWS (optional / not used by default) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
