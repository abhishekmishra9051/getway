<IfModule mod_rewrite.c>
    Options -Indexes
    <IfModule mod_dir.c>
        # Application routes can share names with private project directories.
        DirectorySlash Off
    </IfModule>

    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Canonicalize external /public URLs; internal rewrites do not match THE_REQUEST.
    RewriteCond %{THE_REQUEST} \s/+[^\s?]*/public(?:[/\s?]) [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+public(?:[/\s?]) [NC]
    RewriteRule ^public/?(.*)$ $1 [R=308,L]

    # 1. Strictly block public HTTP access to sensitive files and directories
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]
    # Public disk URLs go through Laravel's bounded file controller, never the
    # physical project storage directory (and require no symlink).
    RewriteRule ^storage(?:/.*)?$ index.php [L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests|scripts)(\/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.(json|lock)|phpunit\.xml|deployment-private-check\.txt) - [F,L,NC]

    # 2. Allow direct access to install.php if requested
    RewriteRule ^(index|install)\.php$ - [L,NC]
    RewriteRule ^public(?:/|$) - [L,NC]

    # 3. Use the bounded public-asset/front-controller fallback.
    RewriteCond %{REQUEST_URI} !(^|/)public/ [NC]
    RewriteRule ^ index.php [L]
</IfModule>
